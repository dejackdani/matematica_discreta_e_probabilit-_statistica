		{"id":"e_gov11","fromNode":"rule_mathjax","fromSide":"right","toNode":"sk_wiki_exercises","toSide":"left","toEnd":"arrow","label":"Sintassi $ e $$"},
		{"id":"e_gov12","fromNode":"rule_mathjax","fromSide":"right","toNode":"sk_generate_flashcards","toSide":"left","toEnd":"arrow","label":"Sintassi $ e $$"},
